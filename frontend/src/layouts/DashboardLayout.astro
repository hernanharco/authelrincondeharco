---
export const prerender = false;
import '../styles/global.css';
import { SITE_TITLE } from '../config';
import { apiUrl, ENDPOINTS } from '../config/api.config';

interface Props {
  title: string;
  pendingCount?: number;
}

const { title, pendingCount = 0 } = Astro.props;

// El middleware ya garantiza token válido y rol ADMIN/SUPERADMIN
const token = Astro.cookies.get('access_token')!.value;

// Obtener información del usuario actual
const res = await fetch(apiUrl(ENDPOINTS.users.me), {
  headers: { Authorization: `Bearer ${token}` },
});

const currentUser = res.ok ? await res.json() : { full_name: '', username: 'Usuario', role: '' };

// Obtener conteo de pendientes
let pendingUsersCount = pendingCount;
if (pendingUsersCount === 0) {
  try {
    const pendingRes = await fetch(apiUrl(ENDPOINTS.users.pending), {
      headers: { Authorization: `Bearer ${token}` },
    });
    if (pendingRes.ok) {
      const pendingUsers = await pendingRes.json();
      pendingUsersCount = pendingUsers.length;
    }
  } catch (error) {
    console.error('Error fetching pending users:', error);
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="AuthCore Dashboard" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {SITE_TITLE}</title>
  </head>
  <body class="bg-[#0F1117] text-[#F9FAFB] min-h-screen">
    <div class="flex h-screen relative">
      <div id="mobileMenuOverlay" class="lg:hidden fixed inset-0 bg-black/50 z-40 hidden"></div>

      <aside
        id="sidebar"
        class="fixed lg:relative lg:translate-x-0 -translate-x-full transition-transform duration-300 ease-in-out z-50 w-60 h-full bg-[#1A1D27] border-r border-[#2D3148] flex flex-col"
      >
        <div class="p-6 border-b border-[#2D3148]">
          <h1 class="text-xl font-bold text-[#6366F1]">AuthCore</h1>
          <p class="text-sm text-[#9CA3AF] mt-1">Panel de Administración</p>
        </div>

        <nav class="flex-1 p-4">
          <ul class="space-y-2">
            <li>
              <a
                href="/dashboard"
                class="flex items-center px-3 py-2 rounded-lg text-sm font-medium transition-colors hover:bg-[#2D3148] text-[#F9FAFB]"
              >
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                </svg>
                Overview
              </a>
            </li>
            <li>
              <a
                href="/dashboard/users"
                class="flex items-center px-3 py-2 rounded-lg text-sm font-medium transition-colors hover:bg-[#2D3148] text-[#F9FAFB]"
              >
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                Usuarios
              </a>
            </li>
            <li>
              <a
                href="/dashboard/pending"
                class="flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition-colors hover:bg-[#2D3148] text-[#F9FAFB]"
              >
                <div class="flex items-center">
                  <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  Pendientes
                </div>
                {
                  pendingUsersCount > 0 && (
                    <span class="bg-[#EF4444] text-white text-xs px-2 py-1 rounded-full">
                      {pendingUsersCount}
                    </span>
                  )
                }
              </a>
            </li>
            <li>
              <a
                href="/dashboard/companies"
                class="flex items-center px-3 py-2 rounded-lg text-sm font-medium transition-colors hover:bg-[#2D3148] text-[#F9FAFB]"
              >
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                Empresas
              </a>
            </li>
            <li>
              <a
                href="/dashboard/tenants"
                class="flex items-center px-3 py-2 rounded-lg text-sm font-medium transition-colors hover:bg-[#2D3148] text-[#F9FAFB]"
              >
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                Tenants
              </a>
            </li>
            <li>
              <a
                href="/dashboard/origins"
                class="flex items-center px-3 py-2 rounded-lg text-sm font-medium transition-colors hover:bg-[#2D3148] text-[#F9FAFB]"
              >
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                </svg>
                Orígenes
              </a>
            </li>
          </ul>
        </nav>

        <div class="p-4 border-t border-[#2D3148]">
          <div class="flex items-center">
            <div
              class="w-8 h-8 bg-[#6366F1] rounded-full flex items-center justify-center text-white font-semibold text-sm"
            >
              {currentUser.full_name ? currentUser.full_name.charAt(0).toUpperCase() : 'U'}
            </div>
            <div class="ml-3 flex-1">
              <p class="text-sm font-medium text-[#F9FAFB]">
                {currentUser.full_name || currentUser.username}
              </p>
              <p class="text-xs text-[#9CA3AF]">{currentUser.role}</p>
            </div>
            
            <button
              id="logoutBtn"
              type="button"
              class="p-2 text-[#9CA3AF] hover:text-[#F9FAFB] transition-colors"
              title="Cerrar sesión"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
              </svg>
            </button>
          </div>
        </div>
      </aside>

      <main class="flex-1 flex flex-col overflow-hidden" data-token={token}>
        <header class="bg-[#1E2130] border-b border-[#2D3148] px-6 py-4">
          <div class="flex items-center justify-between">
            <div>
              <h1 class="text-2xl font-semibold text-[#F9FAFB]">{title}</h1>
              <nav class="text-sm text-[#9CA3AF] mt-1">
                <a href="/dashboard" class="hover:text-[#F9FAFB]">Dashboard</a>
                {title !== 'Overview' && (
                  <>
                    <span class="mx-2">/</span>
                    <span>{title}</span>
                  </>
                )}
              </nav>
            </div>
          </div>
        </header>

        <div class="flex-1 overflow-auto p-6">
          <slot />
        </div>
      </main>
    </div>

    <button
      id="mobileMenuButton"
      class="lg:hidden fixed bottom-4 right-4 bg-[#6366F1] text-white p-3 rounded-full shadow-lg z-50"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <script>
      const mobileMenuButton = document.getElementById('mobileMenuButton');
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('mobileMenuOverlay');

      function toggleMobileMenu() {
        sidebar?.classList.toggle('-translate-x-full');
        overlay?.classList.toggle('hidden');
      }

      function closeMobileMenu() {
        sidebar?.classList.add('-translate-x-full');
        overlay?.classList.add('hidden');
      }

      mobileMenuButton?.addEventListener('click', toggleMobileMenu);
      overlay?.addEventListener('click', closeMobileMenu);

      // Cerrar menú al redimensionar
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024) closeMobileMenu();
      });

      // Lógica de LOGOUT mediante Fetch
      document.getElementById('logoutBtn')?.addEventListener('click', async () => {
  console.log("Iniciando limpieza de sesión...");
  
  try {
    // 1. Intentamos borrar en el servidor
    await fetch('/api/auth/logout', { method: 'POST' });
  } catch (e) {
    console.error("Error servidor:", e);
  } finally {
    // 2. LIMPIEZA MANUAL EN CLIENTE (El martillo)
    const domain = ".elrincondeharco.com";
    
    // Intentamos borrar la cookie con todas las combinaciones posibles
    document.cookie = `access_token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=${domain}; SameSite=None; Secure`;
    document.cookie = `access_token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; SameSite=None; Secure`;
    document.cookie = "access_token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/";

    console.log("Cookie limpiada, redirigiendo...");
    window.location.href = '/login';
  }
});
    </script>
  </body>
</html>