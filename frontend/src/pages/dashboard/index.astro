---
export const prerender = false;
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import StatsCard from '../../components/dashboard/StatsCard.svelte';
import UserAvatar from '../../components/dashboard/UserAvatar.svelte';
import OriginBadge from '../../components/dashboard/OriginBadge.svelte';
import Icon from '../../components/common/Icon.svelte';
import { getRelativeTime } from '../../utils/date';
import { apiUrl, ENDPOINTS } from '../../config/api.config';

// Obtener token de autenticación
const token = Astro.cookies.get('session')?.value;
if (!token) return Astro.redirect('/login');

// Obtener estadísticas
let stats = null;
let recentUsers = [];
let pendingUsers = [];

try {
	const [statsRes, recentRes, pendingRes] = await Promise.all([
		fetch(apiUrl(ENDPOINTS.users.stats), {
			headers: { Authorization: `Bearer ${token}` },
		}),
		fetch(apiUrl(ENDPOINTS.users.list) + '?limit=5', {
			headers: { Authorization: `Bearer ${token}` },
		}),
		fetch(apiUrl(ENDPOINTS.users.pending), {
			headers: { Authorization: `Bearer ${token}` },
		}),
	]);
	if (statsRes.ok) stats = await statsRes.json();
	if (recentRes.ok) recentUsers = await recentRes.json();
	if (pendingRes.ok) pendingUsers = await pendingRes.json();
} catch (e) {
	console.error(e);
}
---

<DashboardLayout title="Overview" pendingCount={pendingUsers.length}>
	<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="space-y-6">
			<!-- Header Section -->
			<div class="bg-gradient-to-r from-[#6366F1] to-[#8B5CF6] rounded-xl p-8 text-white shadow-lg">
				<h1 class="text-3xl font-bold mb-2">Panel de Administración</h1>
				<p class="text-white/80">Gestiona usuarios y monitorea el sistema</p>
			</div>

			<!-- Stats Cards -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
				<StatsCard
					title="Total Usuarios"
					value={stats?.total || 0}
					color="primary"
					iconName="user"
				/>
				<StatsCard
					title="Activos"
					value={stats?.by_status?.ACTIVE || 0}
					color="success"
					iconName="active"
				/>
				<StatsCard
					title="Pendientes"
					value={stats?.by_status?.PENDING || 0}
					color="warning"
					iconName="pending"
				/>
				<StatsCard
					title="Bloqueados"
					value={stats?.locked_accounts || 0}
					color="danger"
					iconName="locked"
				/>
			</div>

			<!-- Charts Section -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
				<div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-6">
					<h3 class="text-lg font-semibold text-[#F9FAFB] mb-4">Distribución por Rol</h3>
					<div class="space-y-3">
						{
							Object.entries(stats?.by_role || {}).map(([role, count]) => (
								<div class="flex items-center justify-between">
									<span class="text-sm text-[#9CA3AF]">{role}</span>
									<div class="flex items-center">
										<div class="w-32 bg-[#2D3148] rounded-full h-2 mr-3">
											<div
												class="bg-[#6366F1] h-2 rounded-full"
												style={`width: ${stats ? (Number(count) / stats.total) * 100 : 0}%`}
											/>
										</div>
										<span class="text-sm font-medium text-[#F9FAFB]">{count}</span>
									</div>
								</div>
							))
						}
					</div>
				</div>

				<div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-6">
					<h3 class="text-lg font-semibold text-[#F9FAFB] mb-4">Distribución por Estado</h3>
					<div class="space-y-3">
						{
							Object.entries(stats?.by_status || {}).map(([status, count]) => (
								<div class="flex items-center justify-between">
									<span class="text-sm text-[#9CA3AF]">{status}</span>
									<div class="flex items-center">
										<div class="w-32 bg-[#2D3148] rounded-full h-2 mr-3">
											<div
												class={`h-2 rounded-full ${
													status === 'ACTIVE'
														? 'bg-[#10B981]'
														: status === 'PENDING'
															? 'bg-[#F59E0B]'
															: status === 'SUSPENDED'
																? 'bg-[#EF4444]'
																: 'bg-[#6B7280]'
												}`}
												style={`width: ${stats ? (Number(count) / stats.total) * 100 : 0}%`}
											/>
										</div>
										<span class="text-sm font-medium text-[#F9FAFB]">{count}</span>
									</div>
								</div>
							))
						}
					</div>
				</div>
			</div>

			<!-- Recent Users Table -->
			<div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-6">
				<div class="flex justify-between items-center mb-4">
					<h3 class="text-lg font-semibold text-[#F9FAFB]">Usuarios Recientes</h3>
					<a
						href="/dashboard/users"
						class="text-sm text-[#6366F1] hover:text-[#5558E3] transition-colors"
					>
						Ver todos →
					</a>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full">
						<thead>
							<tr class="border-b border-[#2D3148]">
								<th class="text-left py-3 px-4 text-sm font-medium text-[#9CA3AF]">Usuario</th>
								<th class="text-left py-3 px-4 text-sm font-medium text-[#9CA3AF]">Email</th>
								<th class="text-left py-3 px-4 text-sm font-medium text-[#9CA3AF]">Origen</th>
								<th class="text-left py-3 px-4 text-sm font-medium text-[#9CA3AF]">Fecha</th>
							</tr>
						</thead>
						<tbody>
							{
								recentUsers.map((user: any) => (
									<tr class="border-b border-[#2D3148] hover:bg-[#2D3148]/50 transition-colors">
										<td class="py-3 px-4">
											<div class="flex items-center">
												<UserAvatar
													src={user.avatar_url}
													name={user.full_name || user.username}
													size="sm"
													class="mr-3"
												/>
												<div>
													<div class="text-sm font-medium text-[#F9FAFB]">
														{user.full_name || user.username}
													</div>
													<div class="text-xs text-[#9CA3AF]">@{user.username}</div>
												</div>
											</div>
										</td>
										<td class="py-3 px-4 text-sm text-[#9CA3AF]">{user.email}</td>
										<td class="py-3 px-4">
											<OriginBadge origin={user.origin || 'unknown'} />
										</td>
										<td class="py-3 px-4 text-sm text-[#9CA3AF]">
											{getRelativeTime(user.created_at)}
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</div>

			<!-- Quick Actions -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				<a
					href="/dashboard/users"
					class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-4 hover:border-[#6366F1] transition-all group"
				>
					<div class="flex items-center space-x-3">
						<div
							class="w-10 h-10 bg-[#6366F1]/10 rounded-lg flex items-center justify-center group-hover:bg-[#6366F1]/20 transition-colors shrink-0"
						>
							<Icon name="user" size="5" client:load />
						</div>
						<div>
							<h3
								class="text-base font-semibold text-[#F9FAFB] group-hover:text-[#6366F1] transition-colors"
							>
								Gestionar Usuarios
							</h3>
							<p class="text-xs text-[#9CA3AF] mt-1">Ver y editar todos los usuarios</p>
						</div>
					</div>
				</a>

				<a
					href="/dashboard/pending"
					class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-4 hover:border-[#F59E0B] transition-all group"
				>
					<div class="flex items-center space-x-3">
						<div
							class="w-10 h-10 bg-[#F59E0B]/10 rounded-lg flex items-center justify-center group-hover:bg-[#F59E0B]/20 transition-colors shrink-0"
						>
							<Icon name="pending" size="5" client:load />
						</div>
						<div>
							<h3
								class="text-base font-semibold text-[#F9FAFB] group-hover:text-[#F59E0B] transition-colors"
							>
								Aprobaciones Pendientes
							</h3>
							<p class="text-xs text-[#9CA3AF] mt-1">{pendingUsers.length} usuarios esperando</p>
						</div>
					</div>
				</a>

				<a
					href="/dashboard/origins"
					class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-4 hover:border-[#10B981] transition-all group"
				>
					<div class="flex items-center space-x-3">
						<div
							class="w-10 h-10 bg-[#10B981]/10 rounded-lg flex items-center justify-center group-hover:bg-[#10B981]/20 transition-colors shrink-0"
						>
							<Icon name="projects" size="5" client:load />
						</div>
						<div>
							<h3
								class="text-base font-semibold text-[#F9FAFB] group-hover:text-[#10B981] transition-colors"
							>
								Proyectos
							</h3>
							<p class="text-xs text-[#9CA3AF] mt-1">Usuarios por origen</p>
						</div>
					</div>
				</a>
			</div>
		</div>
	</main>
</DashboardLayout>
