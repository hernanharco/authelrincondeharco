---
export const prerender = false;
import DashboardLayout from '@layouts/DashboardLayout.astro';
import { apiUrl, ENDPOINTS } from '@config/api.config';

const token = Astro.cookies.get('access_token')?.value;
if (!token) return Astro.redirect('/login');

let companies = [];
let error = null;

try {
  const res = await fetch(apiUrl(ENDPOINTS.company.list), {
    headers: { Authorization: `Bearer ${token}` },
  });
  if (res.status === 401) return Astro.redirect('/login');
  if (res.ok) {
    companies = await res.json();
  } else {
    const data = await res.json();
    error = data.detail || 'Error al cargar empresas';
  }
} catch (e) {
  console.error('Error fetching companies:', e);
  error = 'No se pudo conectar con el servidor';
}
---

<DashboardLayout title="Empresas">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="space-y-6">
      <!-- Header -->
      <div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-6">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-xl font-semibold text-[#F9FAFB]">Perfiles de Empresa</h2>
            <p class="text-[#9CA3AF] mt-1">
              {companies.length > 0
                ? `${companies.length} empresas registradas`
                : 'Gestioná los datos de empresa de los usuarios'}
            </p>
          </div>
        </div>
      </div>

      {error && (
        <div class="bg-[#EF4444]/10 border border-[#EF4444]/20 rounded-lg p-4">
          <p class="text-[#EF4444]">{error}</p>
        </div>
      )}

      <!-- Listado -->
      <div class="bg-[#1E2130] border border-[#2D3148] rounded-lg overflow-hidden">
        {companies.length > 0 ? (
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-[#2D3148] bg-[#2D3148]/30">
                  <th class="text-left py-3 px-4 text-xs font-semibold text-[#9CA3AF] uppercase tracking-wider">Empresa</th>
                  <th class="text-left py-3 px-4 text-xs font-semibold text-[#9CA3AF] uppercase tracking-wider">Usuario</th>
                  <th class="text-left py-3 px-4 text-xs font-semibold text-[#9CA3AF] uppercase tracking-wider">CIF</th>
                  <th class="text-left py-3 px-4 text-xs font-semibold text-[#9CA3AF] uppercase tracking-wider">Contacto</th>
                  <th class="text-left py-3 px-4 text-xs font-semibold text-[#9CA3AF] uppercase tracking-wider">Teléfono</th>
                  <th class="text-left py-3 px-4 text-xs font-semibold text-[#9CA3AF] uppercase tracking-wider">Acción</th>
                </tr>
              </thead>
              <tbody>
                {companies.map((c: any) => (
                  <tr class="border-b border-[#2D3148] hover:bg-[#2D3148]/50 transition-colors">
                    <td class="py-4 px-4">
                      <div class="text-sm font-medium text-[#F9FAFB]">{c.company_name}</div>
                    </td>
                    <td class="py-4 px-4">
                      <div class="text-sm text-[#F9FAFB]">{c.user_full_name || c.user_username}</div>
                      <div class="text-xs text-[#9CA3AF]">{c.user_email}</div>
                    </td>
                    <td class="py-4 px-4">
                      <div class="text-sm text-[#F9FAFB]">{c.cif || '—'}</div>
                    </td>
                    <td class="py-4 px-4">
                      <div class="text-sm text-[#F9FAFB]">{c.contact_name || '—'}</div>
                    </td>
                    <td class="py-4 px-4">
                      <div class="text-sm text-[#F9FAFB]">{c.phone || '—'}</div>
                    </td>
                    <td class="py-4 px-4">
                      <a
                        href={`/dashboard/users/${c.user_id}`}
                        class="inline-flex items-center px-3 py-1.5 text-sm bg-[#6366F1] text-white rounded-lg hover:bg-[#5558E3] transition-colors"
                      >
                        Editar
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="text-center py-12">
            <div class="w-16 h-16 bg-[#6366F1]/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#6366F1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-[#F9FAFB] mb-2">Sin empresas</h3>
            <p class="text-[#9CA3AF]">No hay perfiles de empresa registrados todavía.</p>
            <p class="text-xs text-[#6B7280] mt-2">Los usuarios pueden agregar su empresa desde su perfil.</p>
          </div>
        )}
      </div>
    </div>
  </main>
</DashboardLayout>
