---
export const prerender = false;
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import UserAvatar from '../../../components/dashboard/UserAvatar.svelte';
import RoleBadge from '../../../components/dashboard/RoleBadge.svelte';
import StatusBadge from '../../../components/dashboard/StatusBadge.svelte';
import OriginBadge from '../../../components/dashboard/OriginBadge.svelte';
import ConfirmModal from '../../../components/dashboard/ConfirmModal.svelte';
import { apiUrl, ENDPOINTS } from '../../../config/api.config';

// Obtener token de autenticación
const token = Astro.cookies.get('session')?.value;
if (!token) {
	return Astro.redirect('/login');
}

// Obtener ID del usuario
const { id } = Astro.params;

// Obtener datos del usuario
let user = null;

try {
	const userRes = await fetch(apiUrl(ENDPOINTS.users.byId(id)), {
		headers: { 'Authorization': `Bearer ${token}` }
	});
	if (userRes.ok) {
		user = await userRes.json();
	} else if (userRes.status === 404) {
		return Astro.redirect('/dashboard/users?error=user_not_found');
	}
} catch (error) {
	console.error('Error fetching user:', error);
	return Astro.redirect('/dashboard/users?error=fetch_error');
}

function formatDate(dateString: string): string {
	if (!dateString) return 'N/A';
	const date = new Date(dateString);
	return date.toLocaleDateString('es-ES', {
		day: '2-digit',
		month: '2-digit',
		year: 'numeric',
		hour: '2-digit',
		minute: '2-digit'
	});
}

function getRelativeTime(dateString: string): string {
	if (!dateString) return 'Nunca';
	
	const date = new Date(dateString);
	const now = new Date();
	const diffMs = now.getTime() - date.getTime();
	const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
	const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

	if (diffHours < 1) return 'hace menos de 1 hora';
	if (diffHours < 24) return `hace ${diffHours} horas`;
	if (diffDays === 1) return 'ayer';
	if (diffDays < 7) return `hace ${diffDays} días`;
	return formatDate(dateString);
}
---

<DashboardLayout title={`Usuario - ${user?.full_name || user?.username}`}>
	<div client:load>
		<script>
			import { onMount } from 'svelte';
			import { apiUrl, ENDPOINTS } from '../../../config/api.config';
			
			let user = $state(@HTML.stringify(user));
			let isLoading = $state(false);
			let isEditing = $state(false);
			let editForm = $state({});
			let notesText = $state(user?.notes || '');
			let confirmModal = $state({
				isOpen: false,
				title: '',
				message: '',
				onConfirm: null,
				danger: false
			});

			// Inicializar formulario de edición
			onMount(() => {
				if (user) {
					editForm = {
						full_name: user.full_name || '',
						username: user.username || '',
						email: user.email || ''
					};
				}
			});

			// Obtener token para llamadas API
			function getAuthToken() {
				return document.cookie
					.split(';')
					.map(c => c.trim())
					.find(c => c.startsWith('session='))
					?.split('=')[1];
			}

			// Actualizar información básica del usuario
			async function handleBasicInfoUpdate() {
				isLoading = true;
				try {
					const token = getAuthToken();
					if (!token) {
						window.location.href = '/login';
						return;
					}

					const response = await fetch(apiUrl(ENDPOINTS.users.byId(user.id)), {
						method: 'PUT',
						headers: {
							'Content-Type': 'application/json',
							'Authorization': `Bearer ${token}`
						},
						body: JSON.stringify(editForm)
					});

					if (response.ok) {
						const updatedUser = await response.json();
						user = updatedUser;
						isEditing = false;
					} else {
						console.error('Error updating user:', await response.text());
						alert('Error al actualizar la información del usuario');
					}
				} catch (error) {
					console.error('Error updating user:', error);
					alert('Error al actualizar la información del usuario');
				} finally {
					isLoading = false;
				}
			}

			// Actualizar rol
			async function handleRoleChange(newRole) {
				isLoading = true;
				try {
					const token = getAuthToken();
					if (!token) {
						window.location.href = '/login';
						return;
					}

					const response = await fetch(apiUrl(ENDPOINTS.users.byId(user.id) + '/role'), {
						method: 'PATCH',
						headers: {
							'Content-Type': 'application/json',
							'Authorization': `Bearer ${token}`
						},
						body: JSON.stringify({ role: newRole })
					});

					if (response.ok) {
						user.role = newRole;
					} else {
						console.error('Error updating role:', await response.text());
					}
				} catch (error) {
					console.error('Error updating role:', error);
				} finally {
					isLoading = false;
				}
			}

			// Actualizar estado
			async function handleStatusChange(newStatus) {
				isLoading = true;
				try {
					const token = getAuthToken();
					if (!token) {
						window.location.href = '/login';
						return;
					}

					const response = await fetch(apiUrl(ENDPOINTS.users.byId(user.id) + '/status'), {
						method: 'PATCH',
						headers: {
							'Content-Type': 'application/json',
							'Authorization': `Bearer ${token}`
						},
						body: JSON.stringify({ status: newStatus })
					});

					if (response.ok) {
						user.status = newStatus;
					} else {
						console.error('Error updating status:', await response.text());
					}
				} catch (error) {
					console.error('Error updating status:', error);
				} finally {
					isLoading = false;
				}
			}

			// Bloquear/desbloquear usuario
			async function handleLockToggle() {
				isLoading = true;
				try {
					const token = getAuthToken();
					if (!token) {
						window.location.href = '/login';
						return;
					}

					const response = await fetch(apiUrl(ENDPOINTS.users.byId(user.id) + '/lock'), {
						method: 'PATCH',
						headers: {
							'Content-Type': 'application/json',
							'Authorization': `Bearer ${token}`
						},
						body: JSON.stringify({ is_locked: !user.is_locked })
					});

					if (response.ok) {
						user.is_locked = !user.is_locked;
					} else {
						console.error('Error updating lock:', await response.text());
					}
				} catch (error) {
					console.error('Error updating lock:', error);
				} finally {
					isLoading = false;
				}
			}

			// Guardar notas
			async function handleNotesSave() {
				isLoading = true;
				try {
					const token = getAuthToken();
					if (!token) {
						window.location.href = '/login';
						return;
					}

					const response = await fetch(apiUrl(ENDPOINTS.users.byId(user.id) + '/notes'), {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							'Authorization': `Bearer ${token}`
						},
						body: JSON.stringify({ notes: notesText })
					});

					if (response.ok) {
						user.notes = notesText;
					} else {
						console.error('Error updating notes:', await response.text());
					}
				} catch (error) {
					console.error('Error updating notes:', error);
				} finally {
					isLoading = false;
				}
			}

			// Eliminar usuario
			function handleDeleteUser() {
				confirmModal = {
					isOpen: true,
					title: 'Eliminar Usuario',
					message: `¿Estás seguro de que quieres eliminar al usuario "${user.full_name || user.username}"? Esta acción no se puede deshacer.`,
					onConfirm: () => confirmDeleteUser(),
					danger: true
				};
			}

			async function confirmDeleteUser() {
				isLoading = true;
				try {
					const token = getAuthToken();
					if (!token) {
						window.location.href = '/login';
						return;
					}

					const response = await fetch(apiUrl(ENDPOINTS.users.byId(user.id)), {
						method: 'DELETE',
						headers: {
							'Authorization': `Bearer ${token}`
						}
					});

					if (response.ok) {
						window.location.href = '/dashboard/users';
					} else {
						console.error('Error deleting user:', await response.text());
						alert('Error al eliminar el usuario');
					}
				} catch (error) {
					console.error('Error deleting user:', error);
					alert('Error al eliminar el usuario');
				} finally {
					isLoading = false;
					confirmModal.isOpen = false;
				}
			}

			function closeModal() {
				confirmModal.isOpen = false;
			}

			function toggleEdit() {
				isEditing = !isEditing;
				if (isEditing) {
					editForm = {
						full_name: user.full_name || '',
						username: user.username || '',
						email: user.email || ''
					};
				}
			}
		</script>

		{#if user}
			<div class="space-y-6">
				<!-- Header -->
				<div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-6">
					<div class="flex items-center justify-between">
						<div class="flex items-center space-x-4">
							<UserAvatar 
								src={user.avatar_url} 
								name={user.full_name || user.username}
								size="xl"
							/>
							<div>
								<h1 class="text-2xl font-bold text-[#F9FAFB]">
									{user.full_name || user.username}
								</h1>
								<p class="text-[#9CA3AF]">@{user.username}</p>
								<div class="flex items-center space-x-2 mt-2">
									<RoleBadge role={user.role} />
									<StatusBadge status={user.status} />
									{user.is_locked && (
										<span class="px-2 py-1 rounded-full text-xs font-medium bg-[#EF4444] text-white">
											Bloqueado
										</span>
									)}
								</div>
							</div>
						</div>
						
						<div class="flex space-x-2">
							<button
								onclick={toggleEdit}
								class="px-4 py-2 bg-[#6366F1] text-white rounded-lg hover:bg-[#5558E3] transition-colors"
							>
								{isEditing ? 'Cancelar' : 'Editar'}
							</button>
							<button
								onclick={handleDeleteUser}
								class="px-4 py-2 bg-[#EF4444] text-white rounded-lg hover:bg-[#DC2626] transition-colors"
							>
								Eliminar
							</button>
						</div>
					</div>
				</div>

				<!-- Basic Information -->
				<div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-6">
					<h2 class="text-lg font-semibold text-[#F9FAFB] mb-4">Información Básica</h2>
					
					{#if isEditing}
						<div class="space-y-4">
							<div>
								<label class="block text-sm font-medium text-[#9CA3AF] mb-1">Nombre Completo</label>
								<input
									type="text"
									bind:value={editForm.full_name}
									class="w-full px-3 py-2 bg-[#2D3148] border border-[#374151] rounded-lg text-[#F9FAFB] focus:outline-none focus:ring-2 focus:ring-[#6366F1]"
								/>
							</div>
							<div>
								<label class="block text-sm font-medium text-[#9CA3AF] mb-1">Username</label>
								<input
									type="text"
									bind:value={editForm.username}
									class="w-full px-3 py-2 bg-[#2D3148] border border-[#374151] rounded-lg text-[#F9FAFB] focus:outline-none focus:ring-2 focus:ring-[#6366F1]"
								/>
							</div>
							<div>
								<label class="block text-sm font-medium text-[#9CA3AF] mb-1">Email</label>
								<input
									type="email"
									bind:value={editForm.email}
									class="w-full px-3 py-2 bg-[#2D3148] border border-[#374151] rounded-lg text-[#F9FAFB] focus:outline-none focus:ring-2 focus:ring-[#6366F1]"
								/>
							</div>
							<div class="flex space-x-2">
								<button
									onclick={handleBasicInfoUpdate}
									disabled={isLoading}
									class="px-4 py-2 bg-[#10B981] text-white rounded-lg hover:bg-[#059669] disabled:opacity-50"
								>
									Guardar
								</button>
								<button
									onclick={toggleEdit}
									class="px-4 py-2 bg-[#6B7280] text-white rounded-lg hover:bg-[#4B5563]"
								>
									Cancelar
								</button>
							</div>
						</div>
					{:else}
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
							<div>
								<p class="text-sm text-[#9CA3AF]">Nombre Completo</p>
								<p class="text-[#F9FAFB]">{user.full_name || 'N/A'}</p>
							</div>
							<div>
								<p class="text-sm text-[#9CA3AF]">Username</p>
								<p class="text-[#F9FAFB]">{user.username}</p>
							</div>
							<div>
								<p class="text-sm text-[#9CA3AF]">Email</p>
								<p class="text-[#F9FAFB]">{user.email}</p>
							</div>
							<div>
								<p class="text-sm text-[#9CA3AF]">Origen</p>
								<OriginBadge origin={user.origin || 'unknown'} />
							</div>
						</div>
					{/if}
				</div>

				<!-- Security -->
				<div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-6">
					<h2 class="text-lg font-semibold text-[#F9FAFB] mb-4">Seguridad</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div>
							<p class="text-sm text-[#9CA3AF]">Intentos Fallidos</p>
							<p class="text-[#F9FAFB]">{user.failed_login_attempts || 0}</p>
						</div>
						<div>
							<p class="text-sm text-[#9CA3AF]">Estado de Bloqueo</p>
							<div class="flex items-center space-x-2">
								<span class={user.is_locked ? 'text-[#EF4444]' : 'text-[#10B981]'}>
									{user.is_locked ? 'Bloqueado' : 'Desbloqueado'}
								</span>
								<button
									onclick={handleLockToggle}
									disabled={isLoading}
									class="px-3 py-1 text-sm bg-[#6366F1] text-white rounded hover:bg-[#5558E3] disabled:opacity-50"
								>
									{user.is_locked ? 'Desbloquear' : 'Bloquear'}
								</button>
							</div>
						</div>
					</div>
				</div>

				<!-- Activity -->
				<div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-6">
					<h2 class="text-lg font-semibold text-[#F9FAFB] mb-4">Actividad</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div>
							<p class="text-sm text-[#9CA3AF]">Último Login</p>
							<p class="text-[#F9FAFB]">{getRelativeTime(user.last_login)}</p>
							<p class="text-xs text-[#6B7280]">{formatDate(user.last_login)}</p>
						</div>
						<div>
							<p class="text-sm text-[#9CA3AF]">Total de Logins</p>
							<p class="text-[#F9FAFB]">{user.login_count || 0}</p>
						</div>
						<div>
							<p class="text-sm text-[#9CA3AF]">Última IP</p>
							<p class="text-[#F9FAFB]">{user.last_ip || 'N/A'}</p>
						</div>
						<div>
							<p class="text-sm text-[#9CA3AF]">Fecha de Registro</p>
							<p class="text-[#F9FAFB]">{formatDate(user.created_at)}</p>
						</div>
					</div>
				</div>

				<!-- Notes -->
				<div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-6">
					<h2 class="text-lg font-semibold text-[#F9FAFB] mb-4">Notas del Administrador</h2>
					<textarea
						bind:value={notesText}
						placeholder="Añadir notas sobre este usuario..."
						class="w-full px-3 py-2 bg-[#2D3148] border border-[#374151] rounded-lg text-[#F9FAFB] placeholder-[#6B7280] focus:outline-none focus:ring-2 focus:ring-[#6366F1] resize-none"
						rows="4"
					></textarea>
					<div class="mt-2 flex justify-end">
						<button
							onclick={handleNotesSave}
							disabled={isLoading}
							class="px-4 py-2 bg-[#10B981] text-white rounded-lg hover:bg-[#059669] disabled:opacity-50"
						>
							Guardar Notas
						</button>
					</div>
				</div>
			</div>
		{:else}
			<div class="text-center py-12">
				<p class="text-[#EF4444]">Usuario no encontrado</p>
				<a href="/dashboard/users" class="text-[#6366F1] hover:text-[#5558E3]">
					Volver a la lista de usuarios
				</a>
			</div>
		{/if}

		<ConfirmModal
			isOpen={confirmModal.isOpen}
			title={confirmModal.title}
			message={confirmModal.message}
			confirmText="Eliminar"
			cancelText="Cancelar"
			danger={confirmModal.danger}
			onConfirm={confirmModal.onConfirm}
			onCancel={closeModal}
		/>
	</div>
</DashboardLayout>
