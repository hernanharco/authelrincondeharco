---
export const prerender = false;
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import RoleBadge from "../../../components/dashboard/RoleBadge.svelte";
import StatusBadge from "../../../components/dashboard/StatusBadge.svelte";
import OriginBadge from "../../../components/dashboard/OriginBadge.svelte";
import UserAvatar from "../../../components/dashboard/UserAvatar.svelte";
import { apiUrl, ENDPOINTS } from "../../../config/api.config";

const token = Astro.cookies.get("session")?.value;
if (!token) return Astro.redirect("/login");

const { id } = Astro.params;

let user = null;
try {
  const res = await fetch(apiUrl(ENDPOINTS.users.byId(String(id))), {
    headers: { Authorization: `Bearer ${token}` },
  });
  if (res.status === 401) return Astro.redirect("/login");
  if (res.status === 404) return Astro.redirect("/dashboard/users?error=not_found");
  if (res.ok) user = await res.json();
} catch (e) {
  console.error(e);
}

if (!user) return Astro.redirect("/dashboard/users");

function formatDate(d: string) {
  if (!d) return "N/A";
  return new Date(d).toLocaleDateString("es-ES", {
    day: "2-digit", month: "2-digit", year: "numeric",
    hour: "2-digit", minute: "2-digit",
  });
}
---

<DashboardLayout title={`Usuario - ${user.full_name || user.username}`}>
  <div class="max-w-4xl mx-auto space-y-6">

    <!-- Header -->
    <div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <UserAvatar src={user.avatar_url} name={user.full_name || user.username} size="xl" client:load />
          <div>
            <h1 class="text-2xl font-bold text-[#F9FAFB]">{user.full_name || user.username}</h1>
            <p class="text-[#9CA3AF]">@{user.username}</p>
            <div class="flex items-center gap-2 mt-2">
              <RoleBadge role={user.role} client:load />
              <StatusBadge status={user.status} client:load />
              {user.is_locked && (
                <span class="px-2 py-1 rounded-full text-xs font-medium bg-[#EF4444] text-white">Bloqueado</span>
              )}
            </div>
          </div>
        </div>
        <a href="/dashboard/users" class="text-sm text-[#9CA3AF] hover:text-[#F9FAFB] transition-colors">
          ← Volver
        </a>
      </div>
    </div>

    <!-- Información Básica -->
    <div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-6">
      <h2 class="text-lg font-semibold text-[#F9FAFB] mb-4">Información Básica</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <p class="text-sm text-[#9CA3AF]">Nombre Completo</p>
          <p class="text-[#F9FAFB] font-medium">{user.full_name || "N/A"}</p>
        </div>
        <div>
          <p class="text-sm text-[#9CA3AF]">Username</p>
          <p class="text-[#F9FAFB] font-medium">@{user.username}</p>
        </div>
        <div>
          <p class="text-sm text-[#9CA3AF]">Email</p>
          <p class="text-[#F9FAFB] font-medium">{user.email}</p>
        </div>
        <div>
          <p class="text-sm text-[#9CA3AF]">Origen</p>
          <OriginBadge origin={user.origin || "unknown"} client:load />
        </div>
      </div>
    </div>

    <!-- Gestión de Rol y Estado -->
    <div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-6">
      <h2 class="text-lg font-semibold text-[#F9FAFB] mb-4">Gestión de Acceso</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Cambiar Rol -->
        <div>
          <p class="text-sm text-[#9CA3AF] mb-2">Rol actual</p>
          <form id="role-form" class="flex gap-2">
            <select id="role-select" class="flex-1 px-3 py-2 bg-[#2D3148] border border-[#374151] rounded-lg text-[#F9FAFB] focus:outline-none focus:ring-2 focus:ring-[#6366F1]">
              {["NONE","VIEWER","USER","MANAGER","ADMIN","SUPERADMIN"].map(r => (
                <option value={r} selected={user.role === r}>{r}</option>
              ))}
            </select>
            <button type="button" id="btn-role" class="px-4 py-2 bg-[#6366F1] text-white rounded-lg hover:bg-[#5558E3] transition-colors font-medium">
              Guardar
            </button>
          </form>
        </div>
        <!-- Cambiar Estado -->
        <div>
          <p class="text-sm text-[#9CA3AF] mb-2">Estado actual</p>
          <form id="status-form" class="flex gap-2">
            <select id="status-select" class="flex-1 px-3 py-2 bg-[#2D3148] border border-[#374151] rounded-lg text-[#F9FAFB] focus:outline-none focus:ring-2 focus:ring-[#6366F1]">
              {["ACTIVE","INACTIVE","SUSPENDED","PENDING"].map(s => (
                <option value={s} selected={user.status === s}>{s}</option>
              ))}
            </select>
            <button type="button" id="btn-status" class="px-4 py-2 bg-[#10B981] text-white rounded-lg hover:bg-[#059669] transition-colors font-medium">
              Guardar
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Seguridad -->
    <div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-6">
      <h2 class="text-lg font-semibold text-[#F9FAFB] mb-4">Seguridad</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <p class="text-sm text-[#9CA3AF]">Intentos fallidos</p>
          <p class="text-[#F9FAFB] font-medium">{user.failed_login_attempts || 0}</p>
        </div>
        <div>
          <p class="text-sm text-[#9CA3AF]">Estado de bloqueo</p>
          <div class="flex items-center gap-2 mt-1">
            <span class={user.is_locked ? "text-[#EF4444]" : "text-[#10B981]"}>
              {user.is_locked ? "Bloqueado" : "Desbloqueado"}
            </span>
            <button id="btn-lock" class="px-3 py-1 text-sm bg-[#6366F1] text-white rounded hover:bg-[#5558E3] transition-colors">
              {user.is_locked ? "Desbloquear" : "Bloquear"}
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Actividad -->
    <div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-6">
      <h2 class="text-lg font-semibold text-[#F9FAFB] mb-4">Actividad</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <p class="text-sm text-[#9CA3AF]">Último login</p>
          <p class="text-[#F9FAFB] font-medium">{formatDate(user.last_login)}</p>
        </div>
        <div>
          <p class="text-sm text-[#9CA3AF]">Total logins</p>
          <p class="text-[#F9FAFB] font-medium">{user.login_count || 0}</p>
        </div>
        <div>
          <p class="text-sm text-[#9CA3AF]">Fecha de registro</p>
          <p class="text-[#F9FAFB] font-medium">{formatDate(user.created_at)}</p>
        </div>
        <div>
          <p class="text-sm text-[#9CA3AF]">Última IP</p>
          <p class="text-[#F9FAFB] font-medium">{user.last_ip || "N/A"}</p>
        </div>
      </div>
    </div>

  </div>

  <script define:vars={{ userId: user.id, userIsLocked: user.is_locked }}>
    const BACKEND = "http://localhost:8001";

    async function patchUser(path, body) {
      const res = await fetch(`/api/users/action`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ...body, userId: userId, _path: path }),
      });
      if (res.ok) {
        window.location.reload();
      } else {
        const err = await res.json();
        alert(err.detail || "Error en la operación");
      }
    }

    document.getElementById("btn-role").addEventListener("click", () => {
      const role = document.getElementById("role-select").value;
      patchUser("role", { action: "role", role });
    });

    document.getElementById("btn-status").addEventListener("click", () => {
      const status = document.getElementById("status-select").value;
      patchUser("status", { action: "status", status });
    });

    let isLocked = userIsLocked;
    document.getElementById("btn-lock").addEventListener("click", () => {
      patchUser("lock", { action: "lock", is_locked: !isLocked });
    });
  </script>
</DashboardLayout>
