---
export const prerender = false;
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import UserAvatar from '../../../components/dashboard/UserAvatar.svelte';
import RoleBadge from '../../../components/dashboard/RoleBadge.svelte';
import StatusBadge from '../../../components/dashboard/StatusBadge.svelte';
import OriginBadge from '../../../components/dashboard/OriginBadge.svelte';
import { getRelativeTime } from '../../../utils/date';
import { apiUrl, ENDPOINTS } from '../../../config/api.config';

// Obtener token de autenticación
const token = Astro.cookies.get('access_token')?.value;
if (!token) {
	return Astro.redirect('/login');
}

// Obtener parámetros de query
const url = new URL(Astro.request.url);
const searchRole = url.searchParams.get('role') || '';
const searchStatus = url.searchParams.get('status') || '';
const searchOrigin = url.searchParams.get('origin') || '';
const searchQuery = url.searchParams.get('search') || '';

// Construir query string
const queryParams = new URLSearchParams();
if (searchRole) queryParams.append('role', searchRole);
if (searchStatus) queryParams.append('status', searchStatus);
if (searchOrigin) queryParams.append('origin', searchOrigin);
if (searchQuery) queryParams.append('search', searchQuery);

// Obtener usuarios
let users = [];
let stats = null;

try {
	const [usersRes, statsRes] = await Promise.all([
		fetch(
			apiUrl(ENDPOINTS.users.list) + (queryParams.toString() ? '?' + queryParams.toString() : ''),
			{
				headers: { Authorization: `Bearer ${token}` },
			},
		),
		fetch(apiUrl(ENDPOINTS.users.stats), {
			headers: { Authorization: `Bearer ${token}` },
		}),
	]);

	// Manejar respuesta 401
	if (usersRes.status === 401 || statsRes.status === 401) {
		return Astro.redirect('/login');
	}

	if (usersRes.ok) {
		users = await usersRes.json();
	}
	if (statsRes.ok) {
		stats = await statsRes.json();
	}
} catch (error) {
	console.error('Error fetching users:', error);
}
---

<DashboardLayout title="Gestión de Usuarios">
	<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="space-y-6">
			<!-- Header con búsqueda y filtros -->
			<div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-6">
				<div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
					<div>
						<h2 class="text-xl font-semibold text-[#F9FAFB]">Lista de Usuarios</h2>
						<p class="text-[#9CA3AF] mt-1">{stats?.total || users.length} usuarios registrados</p>
					</div>
					<div class="flex flex-col sm:flex-row gap-3">
						<div class="relative">
							<form method="GET" class="contents">
								<input
									type="text"
									name="search"
									value={searchQuery}
									placeholder="Buscar usuarios..."
									class="w-full sm:w-64 px-4 py-2 pl-10 bg-[#2D3148] border border-[#374151] rounded-lg text-[#F9FAFB] placeholder-[#6B7280] focus:outline-none focus:ring-2 focus:ring-[#6366F1] focus:border-transparent"
								/>
								<input type="hidden" name="role" value={searchRole} />
								<input type="hidden" name="status" value={searchStatus} />
								<input type="hidden" name="origin" value={searchOrigin} />
							</form>
							<svg
								class="absolute left-3 top-2.5 w-4 h-4 text-[#6B7280]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
							</svg>
						</div>
						<form method="GET" class="contents">
							<select
								name="role"
								class="px-4 py-2 bg-[#2D3148] border border-[#374151] rounded-lg text-[#F9FAFB] focus:outline-none focus:ring-2 focus:ring-[#6366F1]"
								onchange="this.form.submit()"
							>
								<option value="" selected={!searchRole}>Todos los roles</option>
								<option value="ADMIN" selected={searchRole === 'ADMIN'}>Admin</option>
								<option value="USER" selected={searchRole === 'USER'}>Usuario</option>
								<option value="MANAGER" selected={searchRole === 'MANAGER'}>Manager</option>
								<option value="VIEWER" selected={searchRole === 'VIEWER'}>Viewer</option>
							</select>
							<input type="hidden" name="search" value={searchQuery} />
							<input type="hidden" name="status" value={searchStatus} />
							<input type="hidden" name="origin" value={searchOrigin} />
						</form>
						<form method="GET" class="contents">
							<select
								name="status"
								class="px-4 py-2 bg-[#2D3148] border border-[#374151] rounded-lg text-[#F9FAFB] focus:outline-none focus:ring-2 focus:ring-[#6366F1]"
								onchange="this.form.submit()"
							>
								<option value="" selected={!searchStatus}>Todos los estados</option>
								<option value="ACTIVE" selected={searchStatus === 'ACTIVE'}>Activo</option>
								<option value="INACTIVE" selected={searchStatus === 'INACTIVE'}>Inactivo</option>
								<option value="SUSPENDED" selected={searchStatus === 'SUSPENDED'}>Suspendido</option
								>
								<option value="PENDING" selected={searchStatus === 'PENDING'}>Pendiente</option>
							</select>
							<input type="hidden" name="search" value={searchQuery} />
							<input type="hidden" name="role" value={searchRole} />
							<input type="hidden" name="origin" value={searchOrigin} />
						</form>
					</div>
				</div>
			</div>

			<!-- Estadísticas rápidas -->
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
				<div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-4">
					<div class="flex items-center justify-between">
						<div>
							<p class="text-sm text-[#9CA3AF]">Total</p>
							<p class="text-xl font-bold text-[#F9FAFB]">{stats?.total || users.length}</p>
						</div>
						<div class="w-8 h-8 bg-[#6366F1]/10 rounded-lg flex items-center justify-center">
							<svg
								class="w-4 h-4 text-[#6366F1]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
								></path>
							</svg>
						</div>
					</div>
				</div>
				<div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-4">
					<div class="flex items-center justify-between">
						<div>
							<p class="text-sm text-[#9CA3AF]">Activos</p>
							<p class="text-xl font-bold text-[#10B981]">
								{stats?.by_status?.ACTIVE || users.filter((u: any) => u.status === 'ACTIVE').length}
							</p>
						</div>
						<div class="w-8 h-8 bg-[#10B981]/10 rounded-lg flex items-center justify-center">
							<svg
								class="w-4 h-4 text-[#10B981]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
						</div>
					</div>
				</div>
				<div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-4">
					<div class="flex items-center justify-between">
						<div>
							<p class="text-sm text-[#9CA3AF]">Admins</p>
							<p class="text-xl font-bold text-[#7C3AED]">
								{
									stats?.by_role?.ADMIN + stats?.by_role?.SUPERADMIN ||
										users.filter((u: any) => u.role === 'ADMIN' || u.role === 'SUPERADMIN').length
								}
							</p>
						</div>
						<div class="w-8 h-8 bg-[#7C3AED]/10 rounded-lg flex items-center justify-center">
							<svg
								class="w-4 h-4 text-[#7C3AED]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
								></path>
							</svg>
						</div>
					</div>
				</div>
				<div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-4">
					<div class="flex items-center justify-between">
						<div>
							<p class="text-sm text-[#9CA3AF]">Pendientes</p>
							<p class="text-xl font-bold text-[#F59E0B]">
								{
									stats?.by_status?.PENDING ||
										users.filter((u: any) => u.status === 'PENDING').length
								}
							</p>
						</div>
						<div class="w-8 h-8 bg-[#F59E0B]/10 rounded-lg flex items-center justify-center">
							<svg
								class="w-4 h-4 text-[#F59E0B]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
						</div>
					</div>
				</div>
			</div>

			<!-- Tabla de usuarios con ordenamiento -->
			<div class="bg-[#1E2130] border border-[#2D3148] rounded-lg overflow-hidden">
				<div class="overflow-x-auto">
					<table class="w-full" id="users-table">
						<thead>
							<tr class="border-b border-[#2D3148] bg-[#2D3148]/30">
								<th data-sort="name" class="sortable-header text-left py-3 px-4 text-xs font-semibold text-[#9CA3AF] uppercase tracking-wider cursor-pointer hover:text-[#F9FAFB] transition-colors">
									Usuario <span class="sort-arrow text-[#6B7280]">↕</span>
								</th>
								<th data-sort="email" class="sortable-header text-left py-3 px-4 text-xs font-semibold text-[#9CA3AF] uppercase tracking-wider cursor-pointer hover:text-[#F9FAFB] transition-colors">
									Contacto <span class="sort-arrow text-[#6B7280]">↕</span>
								</th>
								<th data-sort="role" class="sortable-header text-left py-3 px-4 text-xs font-semibold text-[#9CA3AF] uppercase tracking-wider cursor-pointer hover:text-[#F9FAFB] transition-colors">
									Rol <span class="sort-arrow text-[#6B7280]">↕</span>
								</th>
								<th data-sort="status" class="sortable-header text-left py-3 px-4 text-xs font-semibold text-[#9CA3AF] uppercase tracking-wider cursor-pointer hover:text-[#F9FAFB] transition-colors">
									Estado <span class="sort-arrow text-[#6B7280]">↕</span>
								</th>
								<th data-sort="origin" class="sortable-header text-left py-3 px-4 text-xs font-semibold text-[#9CA3AF] uppercase tracking-wider cursor-pointer hover:text-[#F9FAFB] transition-colors">
									Origen <span class="sort-arrow text-[#6B7280]">↕</span>
								</th>
								<th data-sort="last_login" class="sortable-header text-left py-3 px-4 text-xs font-semibold text-[#9CA3AF] uppercase tracking-wider cursor-pointer hover:text-[#F9FAFB] transition-colors">
									Último Acceso <span class="sort-arrow text-[#6B7280]">↕</span>
								</th>
								<th class="text-left py-3 px-4 text-xs font-semibold text-[#9CA3AF] uppercase tracking-wider">Acciones</th>
							</tr>
						</thead>
						<tbody>
							{
								users.map((user: any) => (
									<tr class="border-b border-[#2D3148] hover:bg-[#2D3148]/50 transition-colors user-row"
										data-name={(user.full_name || user.username || '').toLowerCase()}
										data-email={(user.email || '').toLowerCase()}
										data-role={(user.role || '').toLowerCase()}
										data-status={(user.status || '').toLowerCase()}
										data-origin={(user.origin || '').toLowerCase()}
										data-last-login={user.last_login || ''}
									>
										<td class="py-4 px-4">
											<div class="flex items-center">
												<UserAvatar
													src={user.avatar_url}
													name={user.full_name || user.username}
													size="sm"
													class="mr-3"
												/>
												<div>
													<div class="text-sm font-medium text-[#F9FAFB]">
														{user.full_name || user.username}
													</div>
													<div class="text-xs text-[#9CA3AF]">@{user.username}</div>
												</div>
											</div>
										</td>
										<td class="py-4 px-4">
											<div class="text-sm text-[#F9FAFB]">{user.email}</div>
											{user.last_ip && (
												<div class="text-xs text-[#9CA3AF] mt-1">IP: {user.last_ip}</div>
											)}
										</td>
										<td class="py-4 px-4">
											<RoleBadge role={user.role} />
										</td>
										<td class="py-4 px-4">
											<StatusBadge status={user.status} />
										</td>
										<td class="py-4 px-4">
											<OriginBadge origin={user.origin || 'unknown'} />
										</td>
										<td class="py-4 px-4">
											<div class="text-sm text-[#9CA3AF]">{getRelativeTime(user.last_login)}</div>
											{user.login_count > 0 && (
												<div class="text-xs text-[#6B7280] mt-1">{user.login_count} accesos</div>
											)}
										</td>
										<td class="py-4 px-4">
											<div class="flex items-center space-x-2">
												<a
													href={`/dashboard/users/${user.id}`}
													class="p-2 text-[#6366F1] hover:bg-[#6366F1]/10 rounded-lg transition-colors"
													title="Ver detalle"
												>
													<svg
														class="w-4 h-4"
														fill="none"
														stroke="currentColor"
														viewBox="0 0 24 24"
													>
														<path
															stroke-linecap="round"
															stroke-linejoin="round"
															stroke-width="2"
															d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
														/>
														<path
															stroke-linecap="round"
															stroke-linejoin="round"
															stroke-width="2"
															d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
														/>
													</svg>
												</a>
												<a
													href={`/dashboard/users/${user.id}`}
													class="p-2 text-[#F59E0B] hover:bg-[#F59E0B]/10 rounded-lg transition-colors"
													title="Editar"
												>
													<svg
														class="w-4 h-4"
														fill="none"
														stroke="currentColor"
														viewBox="0 0 24 24"
													>
														<path
															stroke-linecap="round"
															stroke-linejoin="round"
															stroke-width="2"
															d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
														/>
													</svg>
												</a>
											</div>
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</div>

			{
				users.length === 0 && (
					<div class="bg-[#1E2130] border border-[#2D3148] rounded-lg p-12 text-center">
						<div class="w-16 h-16 bg-[#6366F1]/10 rounded-full flex items-center justify-center mx-auto mb-4">
							<svg
								class="w-8 h-8 text-[#6366F1]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
								/>
							</svg>
						</div>
						<h3 class="text-lg font-semibold text-[#F9FAFB] mb-2">No hay usuarios</h3>
						<p class="text-[#9CA3AF]">No se encontraron usuarios registrados en el sistema.</p>
					</div>
				)
			}
		</div>
	</main>

	<script>
		// Table sorting
		let currentSort = { column: '', direction: 'asc' };

		document.querySelectorAll('.sortable-header').forEach(header => {
			header.addEventListener('click', () => {
				const column = header.dataset.sort;
				if (!column) return;

				// Toggle direction
				if (currentSort.column === column) {
					currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
				} else {
					currentSort.column = column;
					currentSort.direction = 'asc';
				}

				// Update arrows
				document.querySelectorAll('.sortable-header .sort-arrow').forEach(arrow => {
					arrow.textContent = '↕';
					arrow.classList.remove('text-[#6366F1]');
					arrow.classList.add('text-[#6B7280]');
				});
				const activeArrow = header.querySelector('.sort-arrow');
				if (activeArrow) {
					activeArrow.textContent = currentSort.direction === 'asc' ? '↑' : '↓';
					activeArrow.classList.remove('text-[#6B7280]');
					activeArrow.classList.add('text-[#6366F1]');
				}

				// Sort rows
				const tbody = document.querySelector('#users-table tbody');
				if (!tbody) return;

				const rows = Array.from(tbody.querySelectorAll('.user-row'));
				rows.sort((a, b) => {
					const aVal = (a as HTMLElement).dataset[column] || '';
					const bVal = (b as HTMLElement).dataset[column] || '';

					// Date comparison for last_login
					if (column === 'last_login') {
						const aDate = aVal ? new Date(aVal).getTime() : 0;
						const bDate = bVal ? new Date(bVal).getTime() : 0;
						return currentSort.direction === 'asc' ? aDate - bDate : bDate - aDate;
					}

					// String comparison
					const cmp = aVal.localeCompare(bVal);
					return currentSort.direction === 'asc' ? cmp : -cmp;
				});

				// Re-append sorted rows
				rows.forEach(row => tbody.appendChild(row));
			});
		});
	</script>
</DashboardLayout>
