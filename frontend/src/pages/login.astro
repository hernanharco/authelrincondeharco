---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/auth/LoginForm.svelte';
import GoogleButton from '../components/auth/GoogleButton.svelte';

if (Astro.cookies.has('session')) {
  const token = Astro.cookies.get('session')?.value;
  if (token) {
    const check = await fetch('http://localhost:8001/api/v1/users/me', {
      headers: { 'Authorization': `Bearer ${token}` },
    }).catch(() => null);
    if (check && check.ok) {
      return Astro.redirect('/dashboard');
    } else {
      // Token inválido — borrar cookie
      Astro.cookies.delete('session', { path: '/' });
    }
  }
}
---

<Layout title="Iniciar Sesión - AuthCore">
  <div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
      <div>
        <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
          Inicia sesión en tu cuenta
        </h2>
        <p class="mt-2 text-center text-sm text-gray-600">
          O <a href="/register" class="font-medium text-blue-600 hover:text-blue-500">
            regístrate para empezar
          </a>
        </p>
      </div>

      <LoginForm client:load />
      <GoogleButton client:load />

      <div class="mt-6 text-center">
        <a href="/forgot-password" class="text-sm text-blue-600 hover:text-blue-500">
          ¿Olvidaste tu contraseña?
        </a>
      </div>
    </div>
  </div>
</Layout>
