---
// /src/pages/login.astro
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import LoginForm from "@components/auth/LoginForm.svelte";
import GoogleButton from "@components/auth/GoogleButton.svelte";
import PendingApproval from "@components/auth/PendingApproval.svelte";
import AuthAlert from "@components/auth/AuthAlert.svelte";
import { apiUrl, ENDPOINTS } from "@config/api.config";
import { canAccessDashboard } from "@utils/auth.roles";

// 1. CAPTURA DE PARÁMETROS
const redirectParam = Astro.url.searchParams.get("redirect") ?? "/dashboard";
const status = Astro.url.searchParams.get("status");
const error = Astro.url.searchParams.get("error");
const isPending = status === "pending";

// Detectar modo desarrollo
const isDev = import.meta.env.DEV || process.env.NODE_ENV !== 'production';

// 2. GUARDIA DE ENTRADA
const sessionCookie = Astro.cookies.get("access_token");

if (sessionCookie?.value) {
  try {
    const check = await fetch(apiUrl(ENDPOINTS.users.me), {
      headers: { Authorization: `Bearer ${sessionCookie.value}` },
    });

    if (check.ok) {
      const user = await check.json();
      if (canAccessDashboard(user.role)) {
        const safeRedirect = redirectParam.startsWith('http') 
          ? redirectParam 
          : (redirectParam.startsWith('/') ? redirectParam : `/${redirectParam}`);
        return Astro.redirect(safeRedirect);
      } else if (!isPending) {
        return Astro.redirect("/login?status=pending");
      }
    } else {
      Astro.cookies.delete("access_token", { path: "/" });
    }
  } catch (e) {
    console.error("Error verificando sesión:", e);
  }
}
---

<Layout title={isPending ? "Solicitud Pendiente - AuthCore" : "Iniciar Sesión - AuthCore"}>
  <main class="min-h-screen flex items-center justify-center bg-linear-to-br from-[#0F1117] via-[#1A1D27] to-[#0F1117] px-4 py-12 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
      
      {!isPending && (status || error) && (
        <AuthAlert client:load {status} {error} />
      )}

      <div class="bg-[#1E2130] shadow-2xl rounded-2xl border border-[#2D3148] overflow-hidden">
        {isPending ? (
          <PendingApproval client:load />
        ) : (
          <div class="p-8">
            <div class="text-center mb-8">
              <div class="mx-auto h-12 w-12 bg-[#6366F1] rounded-xl flex items-center justify-center shadow-lg mb-4">
                <svg class="h-7 w-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <h2 class="text-3xl font-bold text-[#F9FAFB] tracking-tight">¡Bienvenido!</h2>
              <p class="mt-2 text-sm text-[#9CA3AF]">Ingresa tus credenciales para acceder</p>
            </div>

            <div class="space-y-6">
              <LoginForm client:load {redirectParam} />
              
              <div class="relative my-6">
                <div class="absolute inset-0 flex items-center">
                  <div class="w-full border-t border-[#2D3148]"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                  <span class="px-3 bg-[#1E2130] text-[#6B7280]">O continúa con</span>
                </div>
              </div>

              <GoogleButton client:load {redirectParam} />

              {/* ── Dev Login Button (solo en desarrollo) ─────────── */}
              {isDev && (
                <div class="relative my-6">
                  <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-[#F59E0B]/30"></div>
                  </div>
                  <div class="relative flex justify-center text-sm">
                    <span class="px-3 bg-[#1E2130] text-[#F59E0B]">🔧 Modo Desarrollo</span>
                  </div>
                </div>
              )}

              {isDev && (
                <button
                  id="dev-login-btn"
                  type="button"
                  class="w-full flex items-center justify-center gap-3 px-4 py-3 bg-[#F59E0B]/10 border border-[#F59E0B]/30 rounded-xl text-[#F59E0B] font-medium hover:bg-[#F59E0B]/20 transition-all cursor-pointer"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  Acceso Rápido (Dev)
                </button>
              )}

              {isDev && (
                <script>
                  document.getElementById('dev-login-btn')?.addEventListener('click', async () => {
                    const btn = document.getElementById('dev-login-btn') as HTMLButtonElement;
                    btn.disabled = true;
                    btn.innerHTML = '<svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> Conectando...';
                    
                    try {
                      const backendUrl = import.meta.env.PUBLIC_BACKEND_URL || 'http://localhost:8000';
                      const res = await fetch(`${backendUrl}/api/v1/auth/dev-login`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                      });
                      
                      if (!res.ok) throw new Error('Dev login failed');
                      
                      const data = await res.json();
                      
                      // Guardar token en cookie
                      document.cookie = `access_token=${data.access_token}; path=/; max-age=${data.expires_in}; samesite=lax`;
                      
                      // Redirigir al dashboard
                      window.location.href = '/dashboard';
                    } catch (err) {
                      btn.disabled = false;
                      btn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg> Acceso Rápido (Dev)';
                      alert('Error: ' + err);
                    }
                  });
                </script>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  </main>
</Layout>