*.pyc
.venv/
.venv*/
*.egg-info/

# ── IDE ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Sistema ──────────────────────────────────
.DS_Store
Thumbs.db
*.log
*.tmp
